# ================================================
# op-stack Environment Variables
# Copy this file to .env and modify as needed
# ================================================

# ============================================
# Database Configuration
# ============================================
MYSQL_ROOT_PASSWORD=root123

# ============================================
# Security Configuration
# ============================================
# JWT secret (must be at least 256 bits for HS256)
JWT_SECRET=your-production-secret-key-for-jwt-token-must-be-at-least-256-bits-long-for-hmac-sha256
JWT_EXPIRATION=7200

# Encryption key for sensitive data (32 bytes for AES-256)
ENCRYPTION_KEY=yourProductionEncryptionKey12345

# Tools service secret key
TOOLS_SECRET_KEY=your-tools-service-secret-key

# ============================================
# Gateway Configuration
# ============================================
# Set to true to enable JWT authentication on gateway
GATEWAY_AUTH_ENABLED=false

# ============================================
# AWS Configuration (for AI features)
# ============================================
# Option 1: Use IAM Role (recommended for production)
USE_IAM_ROLE=false

# Option 2: Use Access Keys (for development)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# AWS Region
AWS_REGION=us-east-1

# Default AI Model
AWS_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# ============================================
# Frontend Configuration
# ============================================
# API Base URL for the frontend
# For local development with Docker: http://localhost:8080
# For production: https://your-domain.com/api
VITE_API_BASE_URL=http://localhost:8080
